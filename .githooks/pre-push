#!/bin/sh

ZERO_SHA="0000000000000000000000000000000000000000"
HAS_ERRORS=0

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA
do
  # Normalize possible CRLF input on Windows terminals/pipes.
  LOCAL_SHA=$(printf '%s' "$LOCAL_SHA" | tr -d '\r')
  REMOTE_SHA=$(printf '%s' "$REMOTE_SHA" | tr -d '\r')
  # Deletion push, no local commits to inspect.
  if [ "$LOCAL_SHA" = "$ZERO_SHA" ]; then
    continue
  fi

  if [ "$REMOTE_SHA" = "$ZERO_SHA" ]; then
    RANGE="$LOCAL_SHA"
  else
    RANGE="$REMOTE_SHA..$LOCAL_SHA"
  fi

  OFFENDING_COMMITS=$(git --no-pager log --format='%h %s' "$RANGE" --grep='^[[:space:]]*Co-Authored-By:' --regexp-ignore-case --extended-regexp)

  if [ -n "$OFFENDING_COMMITS" ]; then
    echo "ERROR: Push blocked."
    echo "Found commits with disallowed Co-Authored-By trailers:"
    echo "$OFFENDING_COMMITS"
    HAS_ERRORS=1
  fi
done

if [ "$HAS_ERRORS" -ne 0 ]; then
  echo "Rewrite the commit message(s) to remove Co-Authored-By and push again."
  exit 1
fi

exit 0
